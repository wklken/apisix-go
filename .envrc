# Share content-addressed and downloaded Go state across this repository's
# worktrees. Keep task outputs and temporary files inside the active worktree.
export APISIX_GO_ROOT="$(git rev-parse --show-toplevel)"
git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
export APISIX_GO_SHARED_CACHE="$(dirname "$git_common_dir")/.cache/shared"

export GOPATH="$APISIX_GO_SHARED_CACHE/go"
export GOBIN="$APISIX_GO_SHARED_CACHE/bin"
export GOCACHE="$APISIX_GO_SHARED_CACHE/go-build"
export GOMODCACHE="$APISIX_GO_SHARED_CACHE/go-mod"
export GOLANGCI_LINT_CACHE="$APISIX_GO_SHARED_CACHE/golangci-lint"
export GOTMPDIR="$APISIX_GO_ROOT/.cache/tmp"
export TMPDIR="$GOTMPDIR"
export TEST_TELEMETRY_DIR="$APISIX_GO_ROOT/.cache/telemetry"
export BINARY_PATH="$APISIX_GO_ROOT/.cache/out/apisix"
export GOENV=off
export GOTOOLCHAIN="${GOTOOLCHAIN:-auto}"

mkdir -p \
  "$GOPATH" \
  "$GOBIN" \
  "$GOCACHE" \
  "$GOMODCACHE" \
  "$GOLANGCI_LINT_CACHE" \
  "$GOTMPDIR" \
  "$TEST_TELEMETRY_DIR" \
  "$(dirname "$BINARY_PATH")"

# Prefer a toolchain already downloaded into the shared module cache. When it
# is absent, Go's auto-download writes one repository-wide copy there.
toolchain_version="$(awk '$1 == "toolchain" { print $2; exit }' "$APISIX_GO_ROOT/go.mod" 2>/dev/null)"
if [[ -n "$toolchain_version" ]]; then
  while IFS= read -r candidate; do
    if [[ -x "$candidate/bin/go" ]]; then
      export GOROOT="$candidate"
      export PATH="$candidate/bin:$PATH"
      export GOTOOLCHAIN=local
      break
    fi
  done < <(find "$GOMODCACHE/golang.org" -maxdepth 1 -type d -name "toolchain@v0.0.1-$toolchain_version.*" -print 2>/dev/null)
fi

export PATH="$GOBIN:$PATH"
